# Valores que deben ir en el .env del servidor (producción).
# Copia este archivo como .env en el servidor y completa lo que dice CAMBIAR.

APP_NAME="EM Construcciones"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://CAMBIAR-dominio-del-cliente.com
APP_KEY=            # php artisan key:generate

LOG_LEVEL=warning

# Sesiones y cookies seguras (solo por HTTPS)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BCRYPT_ROUNDS=12

# Datos de la landing
LANDING_WHATSAPP=523129432555
LANDING_TELEFONO="+52 312 943 2555"
LANDING_RESPONSABLE="CAMBIAR: nombre o razón social del responsable"
LANDING_DOMICILIO="CAMBIAR: calle, número, colonia, C.P., Colima, Colima, México"
LANDING_CORREO_PRIVACIDAD="CAMBIAR: correo para temas de privacidad"
META_PIXEL_ID=      # solo si el cliente usa Meta Ads

# Después de subir al servidor:
#   composer install --no-dev --optimize-autoloader
#   php artisan config:cache && php artisan route:cache && php artisan view:cache
#   El dominio debe apuntar a la carpeta /public (nunca a la raíz del proyecto).
